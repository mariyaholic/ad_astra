# Cygnus worktree hygiene (AGENTS.md: credentials & bulky data out of the repo)
state/
scratch/
cxg_venv/
venv/
.venv/
*.pyc
__pycache__/
.pytest_cache/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.env
# built public site (regenerate with: python -m cygnus.publish build)
build/

# machine-local agent/editor config
.claude/
.workbuddy-ai/
.agents/
.commandcode/
.playwright-mcp/
.ruff_cache/
opencode.json
*.ipynb_checkpoints/

# explorer bundle is regenerated by design-system/mockups/build_explorer.py
design-system/mockups/explorer/sky-theme.css
design-system/mockups/explorer/data/
design-system/mockups/explorer/img/
design-system/mockups/data/fetch.log

# never commit archive products or credentials
*.fits
*.fits.gz
rclone.conf

# packaging / OS noise
*.egg-info/
dist/
.DS_Store
Thumbs.db

# per-target light-curve series from generated known-object campaigns: regenerated by `cygnus.campaign run`
campaigns/*/tic*/sector*/normalized_series.csv

# Runner data of known-object campaigns lives on Drive, indexed in storage/locations.jsonl (docs/STORAGE.md):
# a campaign commits its spec, sky_record.json, REPORT.md and SEARCH_LOG.md. Files tracked before
# 2026-09-26 stay tracked (git keeps tracking them); these patterns keep new runner data out of the repo.
campaigns/toi-*/runner/
campaigns/toi-*/tic*/
campaigns/toi-*/period_aliases.json
campaigns/toi-*/stellar_context.json
campaigns/toi-*/event_census.json
campaigns/toi-*/moving_objects.json
campaigns/toi-*/alias_cross_instrument.json
campaigns/toi-*/variability_guard.json
campaigns/toi-*/rv_bounds.json
campaigns/toi-*/context/
# a draft written beside an already-reviewed report (cygnus.multi report never overwrites a reviewed one)
campaigns/*/*.draft.md

# wrangler local cache (holds account id; machine-local)
.wrangler/

# never commit worktrees of this repository (agent task branches)
.worktrees/
# Colab run folders commit their small audit files; Drive capsule mirrors and bulky alias grids stay on Drive
# (indexed in storage/locations.jsonl)
docs/colab_runs/*/cloud/
docs/colab_runs/*/campaigns/*/period_aliases.json
